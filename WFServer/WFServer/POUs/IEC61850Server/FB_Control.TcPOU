    <Method Name="_SetSpcValue" Id="{5ff60e32-239a-477a-b08a-b9708653a02e}">
      <Declaration><![CDATA[(* Sets the value of 'stVal' to the value of 'ctlVal'.
Return value: TRUE => Success; FALSE => Failure. *)
METHOD PROTECTED _SetSpcValue : BOOL
VAR_INPUT
	ipStVal: I_AcsiBATypeBOOLEAN; (* Interface pointer to DA that will be written *)
	uCtlVal: U_AcsiCtlVal; (* Value of 'ctlVal' DA *)
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ipStVal = 0 THEN
	RETURN;
END_IF

ipStVal.bValue:= uCtlVal.SPC;
_SetSpcValue:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SetValue" Id="{87fc1402-7f1a-4ea7-b68c-a774993baa6c}">
      <Declaration><![CDATA[(* Sets the value of the respective DA according to the value of 'Oper.ctlVal'.
Return value: TRUE => Success, FALSE => Failure. *)
METHOD PROTECTED _SetValue : BOOL
VAR_INPUT
	uCtlVal: U_AcsiCtlVal; (* Value of 'ctlVal' DA *)
	ipCtlVal_AV: I_AcsiDATypeAnalogueValue; (* Interface pointer to 'ctlVal' of type AnalogueValue *)
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ipCtrl = 0 THEN
	RETURN;
END_IF

CASE _eType OF
	E_AcsiCDCType.SPC:
		_SetValue:= _SetSpcValue(ipStVal:=_ipCtrl.ipStVal_BOOLEAN, uCtlVal:=uCtlVal);

	E_AcsiCDCType.DPC:
		_SetValue:= _SetDpcValue(ipStVal:=_ipCtrl.ipStVal_Dbpos, uCtlVal:=uCtlVal);

	E_AcsiCDCType.INC:
		_SetValue:= _SetIncValue(ipStVal:=_ipCtrl.ipStVal_INT32, uCtlVal:=uCtlVal);

	E_AcsiCDCType.ENC:
		_SetValue:= _SetEncValue(ipStVal:=_ipCtrl.ipStVal_ENUMERATED, uCtlVal:=uCtlVal);

	E_AcsiCDCType.BSC:
		_SetValue:= _SetBscValue(ipValWTr:=_ipCtrl.ipValWTr, uCtlVal:=uCtlVal);

	E_AcsiCDCType.ISC:
		_SetValue:= _SetIscValue(ipValWTr:=_ipCtrl.ipValWTr, uCtlVal:=uCtlVal);

	E_AcsiCDCType.APC:
		_SetValue:= _SetApcValue(ipMxVal:=_ipCtrl.ipMxVal, uCtlVal:=uCtlVal, ipCtlVal_AV:=ipCtlVal_AV);

	E_AcsiCDCType.BAC:
		_SetValue:= _SetBacValue(ipMxVal:=_ipCtrl.ipMxVal, uCtlVal:=uCtlVal, ipStepSize:=_ipStepSize);

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Test" Id="{402ef940-9cc6-4013-be49-8a6722f88000}">
      <Declaration><![CDATA[(* This method performs the test of the SelectWithValue operation.
Since this test can take multiple PLC cycles, this method is called every cycle, until it returns TRUE. *)
METHOD PROTECTED _Test : BOOL
VAR_OUTPUT
	bTestOk: BOOL; (* Indicates whether the test was successful *)
	eError: E_AcsiServiceError; (* Error code for negative response *)
END_VAR
VAR
	eApplError: E_AcsiApplError; (* Error *)
	eApplAddCause: E_AcsiApplAddCause; (* Application error code *)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (_ipCtrl <> 0) AND_THEN (_ipCtrl.ipSBOw <> 0) THEN
	(* Don't allow control if 'ctlModel' is set to 'status-only' *)
	IF (_ipCtrl.ipCtlModel <> 0) AND_THEN (_ipCtrl.ipCtlModel.eValue = E_AcsiCtlModels.StatusOnly) THEN
		_SendLastApplError(ipAA:=_ipCurrentAA, ipCtrlData:=_ipCtrl.ipSBOw, eError:=E_AcsiApplError.NoError, ipOrigin:=_ipCtrl.ipSBOw.ipOrigin, ipCtlNum:=_ipCtrl.ipSBOw.ipCtlNum, eAddCause:=E_AcsiApplAddCause.Unknown);
		eError:= E_AcsiServiceError.AccessViolation;
		(* Check if 'ctlVal' is valid *)
	ELSIF NOT _CheckCtlVal(uCtlVal:=_ipCtrl.ipSBOw.uCtlVal, eError=>eApplError, eAddCause=>eApplAddCause) THEN
		_SendLastApplError(ipAA:=_ipCurrentAA, ipCtrlData:=_ipCtrl.ipSBOw, eError:=eApplError, ipOrigin:=_ipCtrl.ipSBOw.ipOrigin, ipCtlNum:=_ipCtrl.ipSBOw.ipCtlNum, eAddCause:=eApplAddCause);
		eError:= E_AcsiServiceError.AccessViolation;
		(* SelVal_req is valid *)
	ELSE
		RemoteAddress_From_ScsmAssociation(in:=_ipCurrentAA, out=>_stCurrrentIp);
		bTestOk:= TRUE;
	END_IF
END_IF
_Test:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_UpdateTimestampValue" Id="{acab7cc7-b210-432b-a97b-669e2500f962}">
      <Declaration><![CDATA[(* Sets the value of 't' to the current time.
Return value: TRUE => Success; FALSE => Failure. *)
METHOD PROTECTED _UpdateTimestampValue : BOOL
VAR_INPUT
	ipAA: I_ScsmAssociationClass; (* Interface pointer to application association *)
END_VAR
VAR
	tValue: T_UtcTime; (* Current time *)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (ipAA <> 0) AND_THEN (_ipCtrl <> 0) AND_THEN (_ipCtrl.ipT <> 0) THEN
	_UpdateTimestampValue:= ipAA.GetSystemTime(tT=>tValue);
	_ipCtrl.ipT.tValue:= tValue;
END_IF]]></ST>
      </Implementation>
    </Method>
