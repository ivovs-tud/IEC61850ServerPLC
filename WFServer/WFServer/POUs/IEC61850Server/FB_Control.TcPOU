    <Method Name="OnAbort" Id="{c1f14b71-9cb9-4d46-9afe-3222c71ef4af}">
      <Declaration><![CDATA[METHOD OnAbort : BOOL
VAR_INPUT
	ipReason: I_ServiceErrorClass;
END_VAR
VAR_OUTPUT
	ipResult: I_AsyncServiceResultClass := THIS^;
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* Forward Abort to LastApplError request service *)
IF (_ipLastApplErrorReq <> 0) AND_THEN (_ipLastApplErrorReq.IsBusy()) THEN
	_ipLastApplErrorReq.OnAbort(ipReason:=ipReason);
END_IF
(* Forward Abort to CommandTermination request service *)
IF (_ipCmdTermReq <> 0) AND_THEN (_ipCmdTermReq.IsBusy()) THEN
	_ipCmdTermReq.OnAbort(ipReason:=ipReason);
END_IF

SUPER^.SetCompleted();
fbCompletion.SetCompleted();]]></ST>
      </Implementation>
    </Method>
