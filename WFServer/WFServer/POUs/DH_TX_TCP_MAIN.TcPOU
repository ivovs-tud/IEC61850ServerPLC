<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="DH_TX_TCP_MAIN" Id="{4f7b6f3d-dbb3-48c1-b18c-530c6dc113fd}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM DH_TX_TCP_MAIN
VAR
	sSrvNetID 	: T_AmsNetID := '';(* TwinCAT TCP/IP server network address *)
	bEnable 	: BOOL := TRUE;(* TRUE => Enable client data exchange, FALSE => Disable *)	
	
	bLog		: BOOL := TRUE;(* TRUE => Enable message/error log, FALSE => Disable*)
	
	fbClient : FB_TCPClient := ( sRemoteHost:= '172.19.3.214',(* IP address of remote server! *)
								nRemotePort:= 9003,(* Port number of remote server! *)
								sPrefix := 'CLIENT1::' );(* TCP/IP client (connection) instance *)
								
	fbCloseAll		: FB_SocketCloseAll;
	bInitialize		: BOOL := TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF fbCloseAll.bBusy OR fbCloseAll.bError THEN
	RETURN;
END_IF
bInitialize := FALSE;

fbClient( sSrvNetID := sSrvNetID, bEnable := bEnable, bLog := bLog );]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>