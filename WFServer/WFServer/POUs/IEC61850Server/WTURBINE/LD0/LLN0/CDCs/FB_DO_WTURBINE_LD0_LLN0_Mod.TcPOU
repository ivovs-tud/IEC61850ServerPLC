<TcPlcObject Productversion="">
  <POU Name="FB_DO_WTURBINE_LD0_LLN0_Mod" Id="2b6407ab-8783-4164-a016-f27cbc6998ed" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_assign'}
FUNCTION_BLOCK FB_DO_WTURBINE_LD0_LLN0_Mod EXTENDS FB_AcsiCommonControllableDataClass
VAR_INPUT
	stVal: FB_AcsiDATypeMod := (Fc:=ACSI_FC_ST, TrgOp:=ACSI_TrgOp_dchg, bLinkResult:=THIS^.AddDataToContainer(ipData:=stVal));
	q: FB_AcsiDATypeQuality := (Fc:=ACSI_FC_ST, TrgOp:=ACSI_TrgOp_qchg, bLinkResult:=THIS^.AddDataToContainer(ipData:=q));
	t: FB_AcsiDATypeTimeStamp := (Fc:=ACSI_FC_ST, bLinkResult:=THIS^.AddDataToContainer(ipData:=t));
	ctlModel: FB_AcsiDATypeCtlModels := (Fc:=ACSI_FC_CF, eValue:=E_AcsiCtlModels.DirectWithNormalSecurity, bLinkResult:=THIS^.AddDataToContainer(ipData:=ctlModel));
	Oper: FB_AcsiCDC_Oper_ENUMERATED := (Fc:=ACSI_FC_CO, bLinkResult:=THIS^.AddDataToContainer(ipData:=Oper));
	SBOw: FB_AcsiCDC_SBOw_ENUMERATED := (Fc:=ACSI_FC_CO, bLinkResult:=THIS^.AddDataToContainer(ipData:=SBOw));
	Cancel: FB_AcsiCDC_Cancel_ENUMERATED := (Fc:=ACSI_FC_CO, bLinkResult:=THIS^.AddDataToContainer(ipData:=Cancel));
	
	fbControl: FB_DirectControl := (ipCtrl:=THIS^.AddServerJob(ipEvent:=fbControl, ipCompletion:=fbControl));
END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
