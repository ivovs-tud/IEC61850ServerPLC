  <POU Name="FB_DO_WTURBINE_LD0_WYAW1_YwAngSpt_val" Id="{87d43a65-9cb4-4f2c-8ca0-1015ecd062d7}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_assign'}
FUNCTION_BLOCK FB_DO_WTURBINE_LD0_WYAW1_YwAngSpt_val EXTENDS FB_AcsiCommonControllableDataClass
VAR_INPUT
	origin: FB_AcsiDATypeOriginator := (Fc:=ACSI_FC_MX, bLinkResult:=THIS^.AddDataToContainer(ipData:=origin));
	mxVal: FB_AcsiDATypeAnalogueValue := (Fc:=ACSI_FC_MX, TrgOp:=ACSI_TrgOp_dchg, i:=(bPresence:=FALSE), bLinkResult:=THIS^.AddDataToContainer(ipData:=mxVal));
	q: FB_AcsiDATypeQuality := (Fc:=ACSI_FC_MX, TrgOp:=ACSI_TrgOp_qchg, bLinkResult:=THIS^.AddDataToContainer(ipData:=q));
	t: FB_AcsiDATypeTimeStamp := (Fc:=ACSI_FC_MX, bLinkResult:=THIS^.AddDataToContainer(ipData:=t));
	ctlModel: FB_AcsiDATypeCtlModels := (Fc:=ACSI_FC_CF, TrgOp:=ACSI_TrgOp_dchg, eValue:=E_AcsiCtlModels.DirectWithNormalSecurity, bLinkResult:=THIS^.AddDataToContainer(ipData:=ctlModel));
	Oper: FB_AcsiCDC_Oper_AnalogueValue := (Fc:=ACSI_FC_CO, ctlVal:=(i:=(bPresence:=FALSE)), bLinkResult:=THIS^.AddDataToContainer(ipData:=Oper));
	
	fbControl: FB_DirectControl := (ipCtrl:=THIS^.AddServerJob(ipEvent:=fbControl, ipCompletion:=fbControl));
END_VAR
VAR
END_VAR]]></Declaration>
