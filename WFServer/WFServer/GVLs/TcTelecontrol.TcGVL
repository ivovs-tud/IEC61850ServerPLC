	fbWTURBINEServerSession2: FB_WTURBINEServerSession := (fbConnection:=(ipServer:=fbWTURBINEServer, settings:=(bEnable:=TRUE)));
	...
	fbWTURBINEServerSessionN: FB_WTURBINEServerSession := (fbConnection:=(ipServer:=fbWTURBINEServer, settings:=(bEnable:=TRUE)));
	*)
	
	
