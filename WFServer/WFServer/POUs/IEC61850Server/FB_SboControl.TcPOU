<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SboControl" Id="{f58dcdca-a269-470a-ac14-ce20330fb718}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SboControl EXTENDS FB_Control
VAR
	_eControlState: E_SboControlState; (*State of control state machine*)
	_fbSboTimer: TON; (*Timer to monitor 'sboTimeout'*)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_CheckCancelReq" Id="{e64033b0-5e25-4221-a26e-61a426d31890}">
      <Declaration><![CDATA[(*This method is called when Cancel_req is received.
It shall check whether the Cancel request is valid and return FALSE as well as an error code if it is not.*)
METHOD PROTECTED _CheckCancelReq : BOOL
VAR_INPUT
	ipDai: I_AcsiDataAccessInfoClass; (*Additional data access info*)
END_VAR
VAR_OUTPUT
	eError: E_AcsiServiceError; (*Error code for negative response*)
END_VAR
VAR
	ipAA: I_ScsmAssociationClass; (*Interface pointer to application association*)
	stRemoteAddr: ST_SockAddr; (*Address of the client that sent the Cancel_req*)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (_ipCtrl <> 0) AND_THEN (_ipCtrl.ipCancel <> 0) THEN
	ScsmAssociation_From_Dai(in:=ipDai, out=>ipAA);
	(* Don't allow control if 'ctlModel' is set to 'status-only' *)
	IF (_ipCtrl.ipCtlModel <> 0) AND_THEN (_ipCtrl.ipCtlModel.eValue = E_AcsiCtlModels.StatusOnly) THEN
		_SendLastApplError(ipAA:=ipAA, ipCtrlData:=_ipCtrl.ipCancel, eError:=E_AcsiApplError.NoError, ipOrigin:=_ipCtrl.ipCancel.ipOrigin, ipCtlNum:=_ipCtrl.ipCancel.ipCtlNum, eAddCause:=E_AcsiApplAddCause.Unknown);
		RETURN;
	(* Cancel is always allowed in state 'Unselected' *)
	ELSIF (_eControlState = E_SboControlState.Unselected) THEN
		_CheckCancelReq:=TRUE;
		RETURN;
	(* Cancel is only allowed by the same client that sent the last accepted Sel_req *)
	ELSIF (RemoteAddress_From_ScsmAssociation(in:=ipAA, out=>stRemoteAddr)) AND_THEN (stRemoteAddr.sAddr <> _stCurrrentIp.sAddr) THEN
		_SendLastApplError(ipAA:=ipAA, ipCtrlData:=_ipCtrl.ipCancel, eError:=E_AcsiApplError.NoError, ipOrigin:=_ipCtrl.ipCancel.ipOrigin, ipCtlNum:=_ipCtrl.ipCancel.ipCtlNum, eAddCause:=E_AcsiApplAddCause.LockedByOtherClient);
		RETURN;
	(* Cancel is not allowed in state 'Operate' *)
	ELSIF (_eControlState = E_SboControlState.Operate) THEN
		_SendLastApplError(ipAA:=ipAA, ipCtrlData:=_ipCtrl.ipCancel, eError:=E_AcsiApplError.NoError, ipOrigin:=_ipCtrl.ipCancel.ipOrigin, ipCtlNum:=_ipCtrl.ipCancel.ipCtlNum, eAddCause:=E_AcsiApplAddCause.CommandAlreadyInExecution);
		RETURN;
	(* Cancel is valid *)
	ELSE
		_CheckCancelReq:=TRUE;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Reset" Id="{6c536712-d4ec-4263-8614-23ad7a38db5c}">
      <Declaration><![CDATA[//Resets all local values
METHOD PROTECTED _Reset
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^._Reset();
(* Reset timer *)
_fbSboTimer(IN:=FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{a2b7e302-4ad6-4f95-84de-df548d6df1a9}">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR
	bTestOk: BOOL; (*Used to cache the return value of the last '_OperativeTest' or '_DynamicTest' method call*)
	eError: E_AcsiServiceError; (*Used to cache the returned error of the last '_OperativeTest' or '_DynamicTest' method call*)
	tValue: T_UtcTime; (*Used to cache the current system time for 'tOpOk'*)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (_ipCtrl <> 0) AND_THEN (_ipCtrl.ipOper <> 0) THEN
	(* Initialize function block in the first cycle *)
	IF NOT bInit THEN
		_Init();
		bInit:=TRUE;
	END_IF

	CASE _eControlState OF
		E_SboControlState.Unselected:
			(* Check if ControlState changed in the last cycle *)
			IF bNewState THEN
				bNewState:=FALSE;
				_Reset();
				(* Reset 'stSeld' *)
				IF (_ipCtrl.ipStSeld <> 0) THEN
					_ipCtrl.ipStSeld.bValue:=FALSE;
				END_IF
			END_IF
			(* Check if a valid Cancel_req was received *)
			IF bCancelReq THEN
				bCancelReq:=FALSE;
			END_IF
			(* Check if a valid Sel_req was received *)
			IF bSelReq THEN
				bSelReq:=FALSE;
				(* Set 'stSeld' *)
				IF (_ipCtrl.ipStSeld <> 0) THEN
					_ipCtrl.ipStSeld.bValue:=TRUE;
				END_IF
				(* Go to next ControlState *)
				_eControlState:=E_SboControlState.Ready;
				bNewState:=TRUE;
			END_IF

		E_SboControlState.Ready:
			(* Check if ControlState changed in the last cycle *)
			IF bNewState THEN
				bNewState:=FALSE;
				(* Start timer *)
				IF (_ipCtrl.ipSboTimeout <> 0) THEN
					_fbSboTimer(IN:=TRUE, PT:=DWORD_TO_TIME(_ipCtrl.ipSboTimeout.nValue));
				END_IF
			END_IF
			_fbSboTimer();
			(* Check if a valid Cancel_req was received, 'sboTimeout' was exceeded or the association was lost *)
			IF bCancelReq OR_ELSE _fbSboTimer.Q OR_ELSE ((_ipCurrentAA <> 0) AND_THEN (_ipCurrentAA.eState <> E_AsyncEnvironmentState.Established)) THEN
				bCancelReq:=FALSE;
				_fbSboTimer(IN:=FALSE);
				(* Go to next ControlState *)
				_eControlState:=E_SboControlState.EndSelection;
				bNewState:=TRUE;
			END_IF
			(* Check if a valid Oper_req was received *)
			IF bOperReq THEN
				bOperReq:=FALSE;
				(* Go to next ControlState *)
				_eControlState:=E_SboControlState.PerformTest;
				bNewState:=TRUE;
			END_IF

		E_SboControlState.PerformTest:
			(* Check if ControlState changed in the last cycle *)
			IF bNewState THEN
				bNewState:=FALSE;
				(* Set 'opRcvd' *)
				IF (_ipCtrl.ipOpRcvd <> 0) THEN
					_ipCtrl.ipOpRcvd.bValue:=TRUE;
				END_IF
			END_IF
			(* Check if a valid Cancel_req was received *)
			IF bCancelReq THEN
				bCancelReq:=FALSE;
				(* Send Oper_resp- *)
				_SendLastApplError(ipAA:=_ipCurrentAA, ipCtrlData:=_ipCtrl.ipOper, eError:=E_AcsiApplError.NoError, ipOrigin:=_ipCtrl.ipOper.ipOrigin, ipCtlNum:=_ipCtrl.ipOper.ipCtlNum, eAddCause:=E_AcsiApplAddCause.AbortionByCancel);
				fbOperCompletion.SetCompleted();
				fbOperCompletion.eServiceError:=E_AcsiServiceError.AccessViolation;
				(* Go to ControlState 'EndSelection' *)
				_eControlState:=E_SboControlState.EndSelection;
				bNewState:=TRUE;
			END_IF
			(* Trigger the operative test until it is finished *)
			IF _OperativeTest(bOperativeTestOk=>bTestOk, eError=>eError) THEN
				(* Reset 'opRcvd' *)
				IF (_ipCtrl.ipOpRcvd <> 0) THEN
					_ipCtrl.ipOpRcvd.bValue:=FALSE;
				END_IF
				IF bTestOk THEN
					(* Go to next ControlState *)
					_eControlState:=E_SboControlState.WaitForExecution;
				ELSE
					fbOperCompletion.SetCompleted();
					fbOperCompletion.eServiceError:=eError;
					(* Go to ControlState 'EndSelection' *)
					_eControlState:=E_SboControlState.EndSelection;
				END_IF
				bNewState:=TRUE;
			END_IF

		E_SboControlState.WaitForExecution:
			(* Check if ControlState changed in the last cycle *)
			IF bNewState THEN
				bNewState:=FALSE;
			END_IF
			(* Check if a Cancel_req was received *)
			IF bCancelReq THEN
				bCancelReq:=FALSE;
				(* Send Oper_resp- *)
				_SendLastApplError(ipAA:=_ipCurrentAA, ipCtrlData:=_ipCtrl.ipOper, eError:=E_AcsiApplError.NoError, ipOrigin:=_ipCtrl.ipOper.ipOrigin, ipCtlNum:=_ipCtrl.ipOper.ipCtlNum, eAddCause:=E_AcsiApplAddCause.AbortionByCancel);
				fbOperCompletion.SetCompleted();
				fbOperCompletion.eServiceError:=E_AcsiServiceError.AccessViolation;
				(* Go to ControlState 'EndSelection' *)
				_eControlState:=E_SboControlState.EndSelection;
				bNewState:=TRUE;
			END_IF
			(* Trigger the dynamic test until it is finished *)
			IF _DynamicTest(bDynamicTestOk=>bTestOk, eError=>eError) THEN
				fbOperCompletion.SetCompleted();
				IF bTestOk THEN
					(* Go to next ControlState *)
					IF (_ipBehVal <> 0) AND_THEN ((_ipBehVal.eValue = E_AcsiBeh.TestBlocked) OR_ELSE (_ipBehVal.eValue = E_AcsiBeh.OnBlocked)) THEN
						_eControlState:=E_SboControlState.MirrorBlockedCommand;
					ELSE
						_eControlState:=E_SboControlState.Operate;
					END_IF
				ELSE
					fbOperCompletion.eServiceError:=eError;
					(* Go to ControlState 'EndSelection' *)
					_eControlState:=E_SboControlState.EndSelection;
				END_IF
				bNewState:=TRUE;
			END_IF

		E_SboControlState.Operate:
			(* Check if ControlState changed in the last cycle *)
			IF bNewState THEN
				bNewState:=FALSE;
				(* Set 'opOk' *)
				IF (_ipCtrl.ipOpOk <> 0) THEN
					_ipCtrl.ipOpOk.bValue:=TRUE;
				END_IF
				(* Set 'tOpOk' *)
				IF (_ipCtrl.ipTOpOk <> 0) AND_THEN (_ipCurrentAA <> 0) AND_THEN (_ipCurrentAA.GetSystemTime(tT=>tValue)) THEN
					_ipCtrl.ipTOpOk.tValue:=tValue;
				END_IF
			END_IF
			(* Update value *)
			_SetValue(uCtlVal:=_ipCtrl.ipOper.uCtlVal, ipCtlVal_AV:=_ipCtrl.ipOper.ipCtlVal_AnalogueValue);
			(* Update Timestamp 't' *)
			_UpdateTimestampValue(ipAA:=_ipCurrentAA);

			(* Reset 'opOk' *)
			IF (_ipCtrl.ipOpOk <> 0) THEN
				_ipCtrl.ipOpOk.bValue:=FALSE;
			END_IF
			(* Go to next ControlState *)
			IF (_ipCtrl.ipSboClass <> 0) AND_THEN (_ipCtrl.ipSboClass.eValue = E_AcsiSboClasses.OperateMany) THEN
				_eControlState:=E_SboControlState.Ready;
			ELSE
				_eControlState:=E_SboControlState.EndSelection;
			END_IF
			bNewState:=TRUE;

		E_SboControlState.MirrorBlockedCommand:
			(* Check if ControlState changed in the last cycle *)
			IF bNewState THEN
				bNewState:=FALSE;
				(* Set 'opOk' *)
				IF (_ipCtrl.ipOpOk <> 0) THEN
					_ipCtrl.ipOpOk.bValue:=TRUE;
				END_IF
				(* Set 'tOpOk' *)
				IF (_ipCtrl.ipTOpOk <> 0) AND_THEN (_ipCurrentAA <> 0) AND_THEN (_ipCurrentAA.GetSystemTime(tT=>tValue)) THEN
					_ipCtrl.ipTOpOk.tValue:=tValue;
				END_IF
			END_IF
			(* Reset 'opOk' *)
			IF (_ipCtrl.ipOpOk <> 0) THEN
				_ipCtrl.ipOpOk.bValue:=FALSE;
			END_IF
			(* Go to next ControlState *)
			IF (_ipCtrl.ipSboClass <> 0) AND_THEN (_ipCtrl.ipSboClass.eValue = E_AcsiSboClasses.OperateMany) THEN
				_eControlState:=E_SboControlState.Ready;
			ELSE
				_eControlState:=E_SboControlState.EndSelection;
			END_IF
			bNewState:=TRUE;

		E_SboControlState.EndSelection:
			(* Check if ControlState changed in the last cycle *)
			IF bNewState THEN
				bNewState:=FALSE;
				(* Reset 'stSeld' *)
				IF (_ipCtrl.ipStSeld <> 0) THEN
					_ipCtrl.ipStSeld.bValue:=FALSE;
				END_IF
			END_IF
			(* Go to next ControlState *)
			_eControlState:=E_SboControlState.Unselected;
			bNewState:=TRUE;
	END_CASE
END_IF

(* Monitor transmission of LastApplError *)
CASE _nLastApplErrorReqState OF
	0:	RETURN;
	1:
		IF (_ipLastApplErrorReq <> 0) THEN
			Execute:=_ipLastApplErrorReq.Execute();
			IF NOT _ipLastApplErrorReq.IsBusy() THEN
				IF _ipLastApplErrorReq.IsCompleted() THEN
					SUPER^.SetCompleted();
				ELSE
					SUPER^.CopyFrom(ipSource:=_ipLastApplErrorReq);
				END_IF
				_nLastApplErrorReqState:=0;
			END_IF
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCompletionWaitEvent" Id="{f9456e38-509e-46df-ae09-eea035a7f55b}">
      <Declaration><![CDATA[METHOD OnCompletionWaitEvent : BOOL
VAR_INPUT
	ipDai: I_AcsiDataAccessInfoClass;
	ipData: I_AcsiCommonDataClass;
	eFc: E_AcsiFc;
END_VAR
VAR_OUTPUT
	ipResult: I_AcsiServiceResultClass := fbCompletion;
END_VAR
VAR
	eServiceError: E_AcsiServiceError;
	ipAA: I_ScsmAssociationClass; (*Interface pointer to application association*)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbCompletion.SetCompleted();
IF (ipDai = 0) OR_ELSE (ipData = 0) THEN
	fbCompletion.eServiceError:=E_AcsiServiceError.AccessViolation;
	RETURN;
END_IF

(* Check if an Operate request is received *)
IF (ipDai.eService = E_AcsiServiceType.SetDataValues) THEN
	IF	(ipData.sObjectName = 'Oper') THEN
		ScsmAssociation_From_Dai(in:=ipDai, out=>_ipCurrentAA);
		fbOperCompletion.SetBusy();
		ipResult:=fbOperCompletion;
		bOperReq:=TRUE;
		OnCompletionWaitEvent:=TRUE;
	ELSIF (ipData.sObjectName = 'Cancel') THEN
		fbCancelCompletion.SetCompleted();
		ipResult:=fbCancelCompletion;
		IF _CheckCancelReq(ipDai:=ipDai, eError=>eServiceError) THEN
			bCancelReq:=TRUE;
		ELSE
			fbCancelCompletion.eServiceError:=eServiceError;
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnGetVEvent" Id="{5c530ed6-9be9-43d3-bbf9-20ffecca9b87}">
      <Declaration><![CDATA[(*Implementation of user application data update event method.*)
METHOD OnGetVEvent
VAR_INPUT
	ipDai: I_AcsiDataAccessInfoClass; (*Additional data access info*)
	ipData: I_AcsiCommonDataClass; (*Interface pointer to data object*)
	eFc: E_AcsiFc; (*Functional constraint*)
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (eFc = E_AcsiFc.CO) AND_THEN (_ipCtrl <> 0) AND_THEN (ipDai <> 0) AND_THEN (ipDai.Read) AND_THEN (ipDai.ipAccessData <> 0) THEN
	IF (ipDai.ipAccessData.sObjectName = 'SBO') AND_THEN (_ipCtrl.ipSBO <> 0) THEN
		(* Reset value of 'SBO' *)
		_ipCtrl.ipSBO.sValue:='';
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnGetVPreEvent" Id="{e12b7886-73e2-4a2d-9c8b-03ef4d81dd06}">
      <Declaration><![CDATA[(*Implementation of user application data update event method.*)
METHOD OnGetVPreEvent : E_AcsiServiceError
VAR_INPUT
	ipDai: I_AcsiDataAccessInfoClass; (*Additional data access info*)
	ipData: I_AcsiCommonDataClass; (*Interface pointer to data object*)
	eFc: E_AcsiFc; (*Functional constraint*)
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (eFc = E_AcsiFc.CO) AND_THEN (_ipCtrl <> 0) AND_THEN (ipDai <> 0) AND_THEN (ipDai.Read) AND_THEN (ipDai.ipAccessData <> 0) THEN
	IF (ipDai.ipAccessData.sObjectName = 'SBO') AND_THEN (_ipCtrl.ipSBO <> 0) THEN
		(* Only allow 'Select' requests in state 'Unselected' *)
		IF (_eControlState = E_SboControlState.Unselected) THEN
			_ipCtrl.ipSBO.sValue:=_ipCtrl.ipSBO.GetSboReference();
			bSelReq:=TRUE;
		ELSE
			_ipCtrl.ipSBO.sValue:='';
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnSetVPreEvent" Id="{a8d62b6a-afb1-46dd-8410-ef011cd65593}">
      <Declaration><![CDATA[(*Implementation of user application data update event method.*)
METHOD OnSetVPreEvent : E_AcsiServiceError
VAR_INPUT
	ipDai: I_AcsiDataAccessInfoClass; (*Additional data access info*)
	ipMemory: I_AnyMemoryBuffer; (*Interface pointer to buffer containig new value data*)
	ipData: I_AcsiCommonDataClass; (*Interface pointer to data object*)
	eFc: E_AcsiFc; (*Functional constraint*)
END_VAR
VAR_OUTPUT
	ipLastApplError: I_AcsiDATypeLastApplError; (*IF <> 0 => send LastApplError request*)
END_VAR
VAR
	ipAA: I_ScsmAssociationClass; (*Interface pointer to application association*)
	bItself: BOOL; (*If TRUE => Checking object is sub-data object itself*)
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (eFc = E_AcsiFc.CO) AND_THEN (_ipCtrl <> 0) AND_THEN (ipDai <> 0) AND_THEN (ipDai.Write) AND_THEN (ipDai.ipAccessData <> 0) AND_THEN (ipData <> 0) AND_THEN ScsmAssociation_From_Dai(in:=ipDai, out=>ipAA) THEN
	IF (_ipCtrl.ipOper <> 0) AND_THEN (_ipCtrl.ipOper.ipOrigin <> 0) AND_THEN (_ipCtrl.ipOper.ipCtlNum <> 0) THEN
		(* Check for invalid write attemps to prevent 'Oper' from being overwritten while a control request is being executed *)
		IF (ipDai.ipAccessData.sObjectName = 'Oper') THEN
			(* Only allow 'Oper' requests in state 'Ready' *)
			IF (_eControlState <> E_SboControlState.Ready) THEN
				ipLastApplError:=ipAA.SetAdditionalCauseDiag(ipCtrlData:=_ipCtrl.ipOper, eError:=E_AcsiApplError.NoError, stOrigin:=_ipCtrl.ipOper.ipOrigin.stOrigin, nCtlNum:=_ipCtrl.ipOper.ipCtlNum.nValue, eAddCause:=E_AcsiApplAddCause.CommandAlreadyInExecution);
				OnSetVPreEvent:=E_AcsiServiceError.AccessViolation;
				RETURN;
			END_IF
		ELSIF (_ipCtrl.ipOper.HasDataSubObject(ipData:=ipDai.ipAccessData, bItself=>bItself) AND_THEN (NOT bItself)) THEN
			(* Don't allow write access to subdata of 'Oper'*)
			ipLastApplError:=ipAA.SetAdditionalCauseDiag(ipCtrlData:=_ipCtrl.ipOper, eError:=E_AcsiApplError.NoError, stOrigin:=_ipCtrl.ipOper.ipOrigin.stOrigin, nCtlNum:=_ipCtrl.ipOper.ipCtlNum.nValue, eAddCause:=E_AcsiApplAddCause.NotSupported);
			OnSetVPreEvent:=E_AcsiServiceError.AccessViolation;
			RETURN;
		END_IF
	END_IF
	IF (_ipCtrl.ipCancel <> 0) AND_THEN (_ipCtrl.ipCancel.ipOrigin <> 0) AND_THEN (_ipCtrl.ipCancel.ipCtlNum <> 0) THEN
		IF (ipDai.ipAccessData.sObjectName <> 'Cancel') AND_THEN (_ipCtrl.ipCancel.HasDataSubObject(ipData:=ipDai.ipAccessData)) THEN
			(* Don't allow write access to subdata of 'Cancel'*)
			ipLastApplError:=ipAA.SetAdditionalCauseDiag(ipCtrlData:=_ipCtrl.ipCancel, eError:=E_AcsiApplError.NoError, stOrigin:=_ipCtrl.ipCancel.ipOrigin.stOrigin, nCtlNum:=_ipCtrl.ipCancel.ipCtlNum.nValue, eAddCause:=E_AcsiApplAddCause.NotSupported);
			OnSetVPreEvent:=E_AcsiServiceError.AccessViolation;
			RETURN;
		END_IF
	END_IF
	IF (ipData.sObjectName = 'SBO') THEN
		(* Don't allow write access to 'SBO'*)
		OnSetVPreEvent:=E_AcsiServiceError.AccessViolation;
		RETURN;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>