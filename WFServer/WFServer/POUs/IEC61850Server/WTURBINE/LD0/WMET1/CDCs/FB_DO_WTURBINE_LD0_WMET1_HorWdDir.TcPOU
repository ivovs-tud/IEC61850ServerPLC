  <POU Name="FB_DO_WTURBINE_LD0_WMET1_HorWdDir" Id="{3592f1a9-d2af-401c-9e01-5e2cf0715a6d}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_assign'}
