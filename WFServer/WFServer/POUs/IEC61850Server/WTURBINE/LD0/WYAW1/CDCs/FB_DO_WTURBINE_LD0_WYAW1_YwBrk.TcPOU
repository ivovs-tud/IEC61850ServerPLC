	Oper: FB_AcsiCDC_Oper_BOOLEAN := (Fc:=ACSI_FC_CO, bLinkResult:=THIS^.AddDataToContainer(ipData:=Oper));
	SBOw: FB_AcsiCDC_SBOw_BOOLEAN := (Fc:=ACSI_FC_CO, bLinkResult:=THIS^.AddDataToContainer(ipData:=SBOw));
	Cancel: FB_AcsiCDC_Cancel_BOOLEAN := (Fc:=ACSI_FC_CO, bLinkResult:=THIS^.AddDataToContainer(ipData:=Cancel));
	
	fbControl: FB_DirectControl := (ipCtrl:=THIS^.AddServerJob(ipEvent:=fbControl, ipCompletion:=fbControl));
END_VAR
VAR
