<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_TCPBinaryHeader" Id="{f29d7f5b-00bb-4fd1-98aa-81be794b6ee1}">
    <Declaration><![CDATA[(* Simple binary TCP/IP frame header (8 byte aligned) *)
TYPE ST_TCPBinaryHeader :
STRUCT
	dwStart		: DWORD	:= 16#BECF1234;	(* Start bytes *)
	cbLength	: UDINT(0..cTCP_BUFFER_SIZE) := 0;(* Max. length of attached binary data *)
	nS			: UDINT := 0;(* Send counter *)
	nR			: UDINT	:= 0;(* Receive counter *)
	
	(* Total header data size = 16 byte *)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>