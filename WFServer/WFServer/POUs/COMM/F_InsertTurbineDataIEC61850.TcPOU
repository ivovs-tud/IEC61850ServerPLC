<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_InsertTurbineDataIEC61850" Id="{0eb7409c-c751-4f7d-afdf-ce35cfcabd6b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_InsertTurbineDataIEC61850
VAR_INPUT
	nID				: UDINT;
	sTurbineData	: S_TURBINEDATA;
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF nID >= 1 OR nID <= c_nNumTurbines THEN
	fbWTURBINE[nID].WTURBINELD0.WMET1.HorWdSpd.mag.fValue := sTurbineData.WindSpeed;
	fbWTURBINE[nID].WTURBINELD0.WMET1.HorWdDir.mag.fValue := sTurbineData.WindDirection;
	fbWTURBINE[nID].WTURBINELD0.WTUR1.W.mag.fValue := sTurbineData.PowerGen;
	fbWTURBINE[nID].WTURBINELD0.WYAW1.YwAng.mag.fValue := sTurbineData.YawAng;
	fbWTURBINE[nID].WTURBINELD0.WROT1.RotSpd.mag.fValue := sTurbineData.RotorSpeed;
	fbWTURBINE[nID].WTURBINELD0.WROT1.BlPthAngVal.mag.fValue := sTurbineData.PitchAngle;
	fbWTURBINE[nID].WTURBINELD0.WROT1.BlPthAngTgt.mag.fValue := sTurbineData.PitchAngleSpt;
// 	fbWTURBINE[nID].WTURBINELD0.WCN
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>