  <POU Name="FB_DO_WTURBINE_LD0_WGEN1_RotSpd" Id="{03e9ee33-76ef-466f-9fff-1bf0544914cd}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_assign'}
