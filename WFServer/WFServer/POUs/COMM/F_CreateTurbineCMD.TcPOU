<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_CreateTurbineCMD" Id="{8091cc33-872d-4ec0-b1d3-c128684dee94}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_CreateTurbineCMD
VAR_INPUT
// 	nID				: UDINT;
END_VAR
VAR_OUTPUT
	sTurbineCmd		: S_TURBINECMD;
END_VAR
VAR
	nID: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
FOR nID := 1 TO c_nNumTurbines DO
	sTurbineCmd.bEnable[nID] := TRUE;
	sTurbineCmd.fWSpt[nID] 	:= fbWTURBINE[nID].WTURBINELD0.WTUR1.DmdWSpt.val.mxVal.fValue;
	sTurbineCmd.fYawSpt[nID] := fbWTURBINE[nID].WTURBINELD0.WYAW1.YwAngSpt.val.mxVal.fValue;
END_FOR]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>