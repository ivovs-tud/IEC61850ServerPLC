    <Method Name="_SetIscValue" Id="{cc38cf03-8035-44ba-be81-24227dfa2e12}">
      <Declaration><![CDATA[(* Sets the value of 'valWTr' to the value of 'ctlVal'.
Return value: TRUE => Success; FALSE => Failure. *)
METHOD PROTECTED _SetIscValue : BOOL
VAR_INPUT
	ipValWTr: I_AcsiDATypeValWithTrans; (* Interface pointer to DA that will be written *)
	uCtlVal: U_AcsiCtlVal; (* Value of 'ctlVal' DA *)
END_VAR
