<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ParseTurbineData" Id="{cf67e8ca-5e2c-4160-af23-b1f7902a7548}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION ParseTurbineData
VAR_INPUT
	sMessage		: POINTER TO BYTE;
END_VAR
VAR_OUTPUT
	sTurbineData	: S_TURBINEDATA;
// 	bOk				: BOOL;
END_VAR
VAR
	i				: UDINT;
	nAddr			: ULINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// bOk := FALSE;

nAddr := 0;
MEMCPY(ADR(sTurbineData.WindSpeed) + nAddr, sMessage + nAddr, SIZEOF(sTurbineData.WindSpeed));
nAddr := nAddr + SIZEOF(sTurbineData.WindSpeed);

MEMCPY(ADR(sTurbineData.WindDirection), sMessage + nAddr, SIZEOF(sTurbineData.WindDirection));
nAddr := nAddr + SIZEOF(sTurbineData.WindDirection);

MEMCPY(ADR(sTurbineData.PowerGen), sMessage + nAddr, SIZEOF(sTurbineData.PowerGen));
nAddr := nAddr + SIZEOF(sTurbineData.PowerGen);

MEMCPY(ADR(sTurbineData.YawAng), sMessage + nAddr, SIZEOF(sTurbineData.YawAng));
nAddr := nAddr + SIZEOF(sTurbineData.YawAng);

MEMCPY(ADR(sTurbineData.RotorSpeed), sMessage + nAddr, SIZEOF(sTurbineData.RotorSpeed));
nAddr := nAddr + SIZEOF(sTurbineData.RotorSpeed);

MEMCPY(ADR(sTurbineData.PitchAngle), sMessage + nAddr, SIZEOF(sTurbineData.PitchAngle));
nAddr := nAddr + SIZEOF(sTurbineData.PitchAngle);

MEMCPY(ADR(sTurbineData.PitchAngleSpt), sMessage + nAddr, SIZEOF(sTurbineData.PitchAngleSpt));
nAddr := nAddr + SIZEOF(sTurbineData.PitchAngleSpt);

MEMCPY(ADR(sTurbineData.GenTorque), sMessage + nAddr, SIZEOF(sTurbineData.GenTorque));
nAddr := nAddr + SIZEOF(sTurbineData.GenTorque);

// bOk := TRUE;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>