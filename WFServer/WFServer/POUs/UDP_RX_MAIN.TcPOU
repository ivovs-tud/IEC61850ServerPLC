<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="UDP_RX_MAIN" Id="{da0e4c2a-35ee-4cf5-990d-e0180ade60e9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM UDP_RX_MAIN
VAR
	fbCloseAll 			: FB_SocketCloseAll;
   	bInitialize			: BOOL := TRUE;
	
	bEnable				: BOOL 			:= TRUE;(* TRUE => Enable/connect, FALSE => Disable/disconnect *)
	bLog				: BOOL			:= TRUE;(* TRUE => Enable log message output, FALSE => Disable *)
	
	fbRx				: FB_UDPRxStateMachine := (sPrefix := 'UDP_RX::');
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* On PLC reset or program download close all opened/created sockets *)
fbCloseAll( sSrvNetId := sSrvNetId, bExecute:= bInitialize );
IF fbCloseAll.bBusy OR fbCloseAll.bError THEN
	RETURN;
END_IF
// IF NOT fbCloseAll.nErrId THEN
//     RETURN; // Not done yet
// END_IF
bInitialize := FALSE;

fbRx(fbRxFifo:=fbRxFIFO, bEnable:=bEnable, bLog:=bLog);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>