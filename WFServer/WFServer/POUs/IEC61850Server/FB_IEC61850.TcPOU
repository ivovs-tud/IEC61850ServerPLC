<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_IEC61850" Id="{c4980344-d71e-4ccf-9e09-bede6b67863a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IEC61850
VAR
	bInitDone: BOOL := FALSE;	

	i: UDINT;
	j: UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bInitDone THEN
	F_IEC61850ServerInit();

	bInitDone := TRUE;
END_IF

FOR i := 1 TO c_nNumTurbines DO
	fbServer[i].Execute();
	FOR j := 1 TO c_nNumSessions DO
		fbSession[i,j]();
	END_FOR
END_FOR]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>